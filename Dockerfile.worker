# ──────────────────────────────────────────────────────────────────────────────
# CrashWise — Master Worker Image
# Self-contained fuzz-node with every fuzzer and build dependency pre-installed.
#
# Usage:
#   docker build -f Dockerfile.worker -t crashwise-worker:latest .
#   docker run --rm -it --privileged crashwise-worker:latest crashwise worker
#
# This image is designed to be the "heavy lifter" — running on Ubuntu 24.04 LTS
# with GLIBC 2.38, Clang 18, LLVM 18, AFL++ 4.09c, Python 3.12, and CMake.
# ──────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 1 — Python Builder (uv on Ubuntu 24.04)
# ═══════════════════════════════════════════════════════════════════════════════
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    git \
    python3 \
    python3-dev \
    python3-venv \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock LICENSE README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY crashwise/ ./crashwise/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 2 — Runtime (Master Worker)
# ═══════════════════════════════════════════════════════════════════════════════
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:/usr/local/bin:$PATH" \
    AFL_PATH="/usr/lib/afl" \
    CC="clang" \
    CXX="clang++"

WORKDIR /app

# Install ALL runtime dependencies in one layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core build tools & sanitizers
    build-essential \
    cmake \
    clang \
    clang-tools \
    gdb \
    lld \
    llvm \
    llvm-dev \
    gcc \
    g++ \
    # AFL++ native package
    afl++ \
    # Common target build dependencies
    zlib1g-dev \
    liblzma-dev \
    libbz2-dev \
    libssl-dev \
    libxml2-dev \
    # Version control & utilities
    git \
    python3 \
    python3-pip \
    python3-venv \
    tini \
    # Docker CLI (so worker can spawn sibling containers if needed)
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
    # Cleanup
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy built virtual environment and application code from builder stage
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/crashwise /app/crashwise

# Verify key tools are present
RUN afl-fuzz -h 2>&1 | head -1 \
    && afl-cc --version 2>&1 | head -1 \
    && clang --version | head -1 \
    && cmake --version | head -1 \
    && /app/.venv/bin/python --version \
    && docker --version

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD /app/.venv/bin/python -c "import crashwise; print(crashwise.__version__)" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["crashwise", "worker"]
