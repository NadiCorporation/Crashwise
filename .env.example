# ──────────────────────────────────────────────────────────────────────────────
# CrashWise environment template — copy to .env and fill in.
# DO NOT commit your real .env. Secrets stay local.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
CRASHWISE_ENV=development
LOG_LEVEL=INFO

# ── Temporal (local cluster via docker-compose) ──────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=crashwise-default

# ── LLM Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default model to use for agentic workflows.
CRASHWISE_LLM_MODEL=claude-sonnet-4-5
CRASHWISE_LLM_TEMPERATURE=0.0

# ── Fuzzing tooling ──────────────────────────────────────────────────────────
AFL_PATH=/usr/bin
LIBFUZZER_CC=clang
SANITIZERS=address,undefined

# ── Storage / artefacts ──────────────────────────────────────────────────────
CRASHWISE_HARNESS_DIR=./harnesses
CRASHWISE_CORPUS_DIR=./corpus
CRASHWISE_CRASH_DIR=./crashes
