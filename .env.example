# ──────────────────────────────────────────────────────────────────────────────
# CrashWise — Runtime Configuration (Operation Megabits)
# ──────────────────────────────────────────────────────────────────────────────

# Storage & Engine Paths
CRASHWISE_WORKDIR=/tmp/crashwise
CRASHWISE_BUILD_TIMEOUT=900
CRASHWISE_FUZZ_TIMEOUT=300

# REST API & Telemetry Daemon
CRASHWISE_API_HOST=0.0.0.0
CRASHWISE_API_PORT=8000

# Cognitive Agent / LLM Configuration
# Supports: DeepSeek, OpenAI, Anthropic, or local Ollama/vLLM endpoints
CRASHWISE_LLM_PROVIDER=deepseek
CRASHWISE_LLM_MODEL=deepseek-chat
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.deepseek.com
