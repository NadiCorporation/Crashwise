# ──────────────────────────────────────────────────────────────────────────────
# CrashWise — Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in the values for your setup.
# DO NOT commit your real `.env` — it contains secrets.
#
#   cp .env.example .env
#
# ──────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# RUNTIME
# ══════════════════════════════════════════════════════════════════════════════

# Environment label: "development" or "production".
CRASHWISE_ENV=development

# Root log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO


# ══════════════════════════════════════════════════════════════════════════════
# TEMPORAL ORCHESTRATION
# ══════════════════════════════════════════════════════════════════════════════
# Temporal is the durable workflow engine that orchestrates fuzzing campaigns.
# When using docker-compose, the service is named "temporal-server".
#
# Local (docker-compose):
#   TEMPORAL_HOST=localhost:7233
#
# Remote Temporal Cloud:
#   TEMPORAL_HOST=your-namespace.tmprl.cloud:7233

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=crashwise-default


# ══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS — Universal Multi-Provider Engine
# ══════════════════════════════════════════════════════════════════════════════
# CrashWise supports plug-and-play LLM routing across any standard provider:
# Anthropic Claude, OpenAI, DeepSeek, Ollama, vLLM, Venice, Groq, Together AI.
#
# Standard environment variable aliases:
#   MODEL_NAME or CRASHWISE_LLM_MODEL
#   OPENAI_API_BASE or OPENAI_BASE_URL
#   OPENAI_API_KEY
#   TEMPERATURE or CRASHWISE_LLM_TEMPERATURE
#   MAX_TOKENS
#   REASONING_EFFORT
# ──────────────────────────────────────────────────────────────────────────────

# ── Primary Model Selection ──────────────────────────────────────────────────
# Examples:
#   deepseek-chat              (DeepSeek — fast, capable, cost-efficient)
#   claude-sonnet-4-5          (Anthropic Claude)
#   gpt-4o                     (OpenAI)
#   llama3.1:8b                (Local Ollama / vLLM)
MODEL_NAME=deepseek-chat
CRASHWISE_LLM_MODEL=deepseek-chat

# Sampling temperature (0.0 = deterministic, recommended for code synthesis).
TEMPERATURE=0.0
CRASHWISE_LLM_TEMPERATURE=0.0

# Max token budget per turn (default: 4096).
MAX_TOKENS=4096

# Reasoning effort for reasoning-capable models ("low", "medium", "high").
REASONING_EFFORT=medium

# ── DeepSeek & OpenAI-Compatible Endpoints ────────────────────────────────────
# DeepSeek:
#   OPENAI_API_BASE=https://api.deepseek.com
#   OPENAI_API_KEY=sk-...
#
# Ollama:
#   OPENAI_API_BASE=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#
# vLLM / Local Proxy:
#   OPENAI_API_BASE=http://localhost:8000/v1
#   OPENAI_API_KEY=none
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=

# ── Anthropic (for claude-* models) ──────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── API & Control Plane Port ─────────────────────────────────────────────────
# Default is 8000 (set to 8001 if port 8000 is occupied on the host).
CRASHWISE_API_PORT=8000
CRASHWISE_API_URL=http://localhost:8000


# ══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS — Crash Triage & Root Cause Analysis
# ══════════════════════════════════════════════════════════════════════════════
# The triage engine uses a separate, lightweight inference layer for crash
# analysis and patch suggestion. This supports local (Ollama) or cloud
# (Venice / any OpenAI-compatible API) backends.
#
# If AI_PROVIDER is not set, triage falls back to heuristic-only analysis
# (regex-based ASAN parsing, no deep RCA). This is perfectly functional
# for basic crash classification.
# ──────────────────────────────────────────────────────────────────────────────

# Provider selection: "ollama", "venice", "openai_compatible", or leave empty for heuristic-only.
AI_PROVIDER=

# ── Option A: Ollama (local, free, private) ──────────────────────────────────
# Install: https://ollama.com/download
# Then pull a model:  ollama pull llama3.1:8b
#
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# OLLAMA_URL=http://localhost:11434

AI_MODEL=
OLLAMA_URL=http://localhost:11434

# ── Option B: Venice AI (cloud, OpenAI-compatible) ───────────────────────────
# Venice provides fast inference with privacy guarantees.
# Sign up: https://venice.ai — API docs: https://docs.venice.ai
#
# AI_PROVIDER=venice
# AI_API_KEY=your-venice-api-key
# AI_MODEL=llama-3.3-70b

# ── Option C: OpenAI-Compatible API (NVIDIA, Together, Groq, etc.) ───────────
# Any provider with /v1/chat/completions endpoint.
#
# AI_PROVIDER=openai_compatible
# AI_MODEL=qwen/qwen2.5-coder-32b-instruct
# AI_API_KEY=nvapi-...
# OLLAMA_URL=https://integrate.api.nvidia.com/v1

AI_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════════════════════
# SQLAlchemy async connection URL.
#
# Development (SQLite — zero setup):
#   DATABASE_URL=sqlite+aiosqlite:///./crashwise.db
#
# Production (PostgreSQL via docker-compose):
#   DATABASE_URL=postgresql+asyncpg://temporal:temporal@localhost:5432/temporal

DATABASE_URL=sqlite+aiosqlite:///./crashwise.db


# ══════════════════════════════════════════════════════════════════════════════
# REDIS (Distributed State)
# ══════════════════════════════════════════════════════════════════════════════
# Used for: dedup cache, coverage counters, MAB state, worker heartbeats.
# Not required for local single-worker dev — set REDIS_ENABLED=false to skip.

REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false


# ══════════════════════════════════════════════════════════════════════════════
# DISTRIBUTED STORAGE (Cloudflare R2 / S3-Compatible)
# ══════════════════════════════════════════════════════════════════════════════
# Used for persisting crash artefacts, corpus snapshots, and reports.
# Not required for local dev — set R2_ENABLED=false to skip.
#
# For local dev with MinIO (via docker-compose):
#   R2_ENABLED=true
#   R2_ENDPOINT_URL=http://localhost:9000
#   R2_ACCESS_KEY_ID=crashwise
#   R2_SECRET_ACCESS_KEY=crashwise-secret
#   R2_BUCKET=crashwise

R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crashwise
R2_ENDPOINT_URL=
R2_REGION=auto


# ══════════════════════════════════════════════════════════════════════════════
# WORKER IDENTITY
# ══════════════════════════════════════════════════════════════════════════════
# Unique name for this worker replica (useful when scaling horizontally).
WORKER_NAME=crashwise-worker-0


# ══════════════════════════════════════════════════════════════════════════════
# NOTIFICATIONS
# ══════════════════════════════════════════════════════════════════════════════
# CrashWise can notify you when critical vulnerabilities are found.
# Supports: Slack/Discord webhooks, email (SMTP), PGP-encrypted email.

NOTIFICATIONS_ENABLED=false

# ── Webhook (Slack / Discord / Custom) ───────────────────────────────────────
# Paste your Slack, Discord, or custom webhook URL here.
# WEBHOOK_FORMAT=slack    # "slack", "discord", or "generic"
WEBHOOK_URL=
WEBHOOK_FORMAT=slack

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=crashwise@yourdomain.com
# SMTP_TO=security-team@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=crashwise@localhost
SMTP_TO=

# ── PGP Encryption (optional — encrypts email body) ─────────────────────────
# Path to the recipient's PGP public key (ASCII-armored).
PGP_PUBLIC_KEY=

# Minimum CVSS score to trigger notifications (0.0–10.0).
MIN_CVSS_THRESHOLD=7.0


# ══════════════════════════════════════════════════════════════════════════════
# FUZZING TOOLING (Host-Mode Only)
# ══════════════════════════════════════════════════════════════════════════════
# These settings are only relevant when running fuzzers directly on the host
# (not via Docker worker). The Docker worker image ships all tools pre-installed.

CRASHWISE_HARNESS_DIR=./harnesses
CRASHWISE_CORPUS_DIR=./corpus
CRASHWISE_CRASH_DIR=./crashes
