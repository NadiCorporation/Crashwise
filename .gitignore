*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# uv / virtualenv ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version
uv.lock.bak

# Testing & coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.cache/
.hypothesis/

# Type checkers / linters ─────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# IDEs / editors ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment & secrets ───────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# C/C++/Rust build artifacts ──────────────────────────────────────────────────
*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.exe
*.out
*.app
target/
Cargo.lock
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.cmake
compile_commands.json

# Fuzzing artifacts ───────────────────────────────────────────────────────────
crashes/
hangs/
queue/
.cur_input
fuzzer_stats
plot_data
fuzz_bitmap
afl-out/
libfuzzer-out/
corpus/*
!corpus/.gitkeep
harnesses/*
!harnesses/.gitkeep
*.profraw
*.profdata
sancov.*

# Docker volumes / runtime ────────────────────────────────────────────────────
.docker/
docker-data/

# Temporal local data ─────────────────────────────────────────────────────────
temporal-data/

# Internal planning documents ─────────────────────────────────────────────────
*MASTER_PRD.md
*PRD.md
*.prompt
*_internal.md

# Local runtime artifacts ─────────────────────────────────────────────────────
# crashwise.db    — SQLite DB created during local testing
# crashwise.yaml  — Generated manifest (created by `crashwise init`)
# targets/        — Local validation targets (cloned during campaigns)
crashwise.db
crashwise.yaml
targets/

# Build cache for hot-swapped harnesses (Phase 21 / S6 hardening) ─────────────
build_cache/
